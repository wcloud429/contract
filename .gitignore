# 비밀 정보 (절대 커밋 금지)
# 법제처 API 인증키(OC 등)는 반드시 .env 에만 두고 커밋하지 않는다.
.env
.env.*
!.env.example    # 예외: 값 없는 템플릿은 커밋 허용
*.local
secrets/
*.key
*.pem

# 휴지통 폴더 (삭제 대기 파일 보관 — 커밋하지 않음)
trash-can/

# 배포 산출물 (build-dist.js 가 생성 → Vercel 빌드 때 재생성하므로 커밋 안 함)
dist/

# 로컬 도구·상태 폴더 (공개 저장소에 넣지 않음)
.bkit/
.claude/

# 의존성 (현재 미사용이나 향후 대비)
node_modules/

# OS 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 에디터 설정
.vscode/
.idea/

# 로그
*.log
